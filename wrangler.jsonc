// Cloudflare Workers static-assets deployment for bombo.gontzi.dev.
// `npm run deploy` builds the site and uploads ./dist.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bombo",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "bombo.gontzi.dev", "custom_domain": true }]
}
